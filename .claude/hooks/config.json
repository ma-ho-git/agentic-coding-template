{
  "_comment": "Thresholds for check_quality.py and check_contract.py. Tune per project; do not delete keys.",
  "max_assignments": 20,
  "max_parameters": 3,
  "max_name_words": 3,
  "max_file_lines": 300,
  "max_nesting_depth": 3,
  "contract_required": true,
  "contract_exempt_globs": [
    "**/test_*.*", "**/*_test.*", "**/*.test.*", "**/*.spec.*",
    "**/tests/**", "**/__tests__/**", "**/spec/**",
    "**/__init__.py", "**/conftest.py",
    "**/migrations/**", "**/generated/**", "**/*.generated.*",
    "**/node_modules/**", "**/dist/**", "**/build/**", "**/vendor/**",
    ".claude/**"
  ],
  "min_lines_for_contract": 10,
  "_gate_comment": "Paths the start gate never blocks: tooling, tests and examples are not the product. Everything that is not a source file is exempt anyway.",
  "gate_exempt_globs": [
    ".claude/**", "tools/**", "tests/**", "examples/**"
  ]
}
